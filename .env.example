# ImgPro — environment template.
#
# Copy to .env and fill in. .env is gitignored; this file is committed and must
# never contain real secrets.

# ── Shopify app identity (required) ──────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://imgproai.onkra.online
SCOPES=write_products,write_files

# Path segment in the hosted pricing URL:
#   admin.shopify.com/store/<store>/charges/<HANDLE>/pricing_plans
# Derived by Shopify from the app name at creation time, NOT from this repo:
# the Dev Dashboard app is "ImgPro Ai", so the handle is "imgpro-ai". Confirmed
# from the Dashboard-generated app version tags (`imgpro-ai-1`, `imgpro-ai-3`),
# which Shopify names after the handle. Shopify also appends a numeric suffix on
# a name collision (previous builds became "optipix-3", "imageboost-seo-1"), so
# re-read this off a real install URL if the app is ever recreated.
SHOPIFY_APP_HANDLE=imgpro-ai

# ── Database (required) ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/imgpro

# ── Feature API keys ─────────────────────────────────────────────────
# AI alt text (Starter+). OpenAI is the only provider. Unset, or set to a key
# whose account has no credit, and every image silently falls back to a generic
# "<product title> - product image" caption.
OPENAI_API_KEY=
# Page Speed reports (Growth+). OPTIONAL — without it the app uses the keyless
# PageSpeed Insights endpoint, which shares a low daily quota. Only set a key
# that has the PageSpeed Insights API enabled: a 403 is not retryable in
# app.pagespeedimpactreports.jsx, so a blocked key is worse than none.
GOOGLE_PAGESPEED_API_KEY=

# Contact address shown on the public /privacy page.
SUPPORT_EMAIL=

# ── Dev-only plan override ───────────────────────────────────────────
# Dev stores can't approve paid managed-pricing plans. Never set in production.
# DEV_PLAN_OVERRIDE=pro
# DEV_PLAN_OVERRIDE_SHOP=your-dev-store.myshopify.com

# ── Encoder tuning (optional; defaults in app/optimize.server.js) ────
# WEBP_QUALITY=76
# WEBP_EFFORT=5
# WEBP_RETRY_QUALITY=66
# WEBP_RETRY_BELOW=20
# MAX_IMAGE_DIM=2048
# MIN_GAIN_PERCENT=2
# SHARP_CONCURRENCY=2
# BATCH_SIZE=10
# BATCH_CONCURRENCY=6
# VISION_IMAGE_WIDTH=512
